# Database URL: Leave blank for local SQLite (leads.db), or provide PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@localhost:5432/leads_db
# DATABASE_URL=postgresql://user:password@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# JobTech API (Arbetsförmedlingen): Free public API. Key is optional for basic tier:
JOBTECH_API_KEY=

# Brainville API: Provide your Brainville API token here. If empty, runs in mock mode for Östergötland testing:
BRAINVILLE_API_KEY=

# Microsoft Teams / Slack Webhook URL for automated executive weekly digests:
TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
